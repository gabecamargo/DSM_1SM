generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pessoa {
  idpessoa  Int       @id @default(autoincrement())
  nome      String    @db.VarChar(30)
  telefones Telefone[]
  carros    PessoaPorCarro[]
}

model Carro {
  idcarro  Int              @id @default(autoincrement())
  modelo   String           @db.VarChar(20)
  pessoas  PessoaPorCarro[]
}

model Telefone {
  idtelefone Int    @id @default(autoincrement())
  numero     String @db.VarChar(11)
  idpessoa   Int

  pessoa Pessoa @relation(fields: [idpessoa], references: [idpessoa], onDelete: Cascade)
}

model PessoaPorCarro {
  idpessoa Int
  idcarro  Int

  pessoa Pessoa @relation(fields: [idpessoa], references: [idpessoa], onDelete: Cascade)
  carro  Carro  @relation(fields: [idcarro], references: [idcarro], onDelete: Cascade)

  @@id([idpessoa, idcarro])
}
